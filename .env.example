# Copy to .env (project root) and adjust. All variables are optional.
# Prefix: EDD_

# Folder with the per-employee bi-weekly workbooks (read-only source of truth)
EDD_DATA_DIR=./Data

# Runtime storage for uploads and generated reports (must NOT be inside EDD_DATA_DIR)
EDD_UPLOAD_DIR=./storage/uploads
EDD_REPORT_DIR=./storage/reports

# Server
EDD_HOST=127.0.0.1
EDD_PORT=8000
EDD_LOG_LEVEL=INFO
EDD_ENVIRONMENT=local
EDD_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Behaviour
EDD_DEFAULT_PERIOD_DAYS=30
EDD_MAX_UPLOAD_MB=25
EDD_REPORT_RETENTION=50

# Jira Cloud (optional). Boards are added by link in the UI (Jira Connections) and stored in
# backend/config/jira_boards.json. Only credentials live here.
EDD_JIRA_EMAIL=you@company.com
EDD_JIRA_API_TOKEN=
EDD_JIRA_AUTO_SYNC=true
EDD_JIRA_CACHE_MINUTES=10
EDD_JIRA_TIMEOUT_SECONDS=30
# Per-board alternative credentials for other Atlassian sites (name the env vars in the board settings)
# EDD_JIRA_EMAIL_<SITE>=
# EDD_JIRA_TOKEN_<SITE>=

# Primary data source: auto | jira | excel | both (can also be changed in Settings)
EDD_DATA_SOURCE=auto
EDD_JIRA_LOOKBACK_DAYS=180
EDD_JIRA_REFRESH_MINUTES=15
EDD_JIRA_MAX_ISSUES_PER_BOARD=3000

# Database (SQLite by default). Create / upgrade the schema with:  python manage.py migrate
EDD_DATABASE_URL=sqlite:///./storage/app.db
EDD_AUTO_MIGRATE=true

# Authentication
EDD_PUBLIC_URL=http://localhost:5173
EDD_SESSION_HOURS=8
EDD_AUTH_SECRET=              # optional; derived from the secret key file when blank
EDD_COOKIE_SECURE=false       # true behind HTTPS
EDD_DEFAULT_ALLOWED_DOMAINS=["endava.com"]

# E-mail (Resend, https://resend.com). Without a key, links are logged (and shown in local env).
EDD_RESEND_API_KEY=
EDD_EMAIL_FROM=Delivery Dashboard <onboarding@resend.dev>

# --- self-healing accounts -------------------------------------------------
# Demo-only logins (demo.admin@example.com / demo.manager@example.com) are re-created on every start. Set 0 to disable.
# EDD_DEMO_ACCOUNTS=1
# When both are set, this superuser is created automatically if the database has no superuser (fresh / lost database).
# EDD_BOOTSTRAP_SUPERUSER_EMAIL=admin@endava.com
# EDD_BOOTSTRAP_SUPERUSER_PASSWORD=Change-Me-2026!

# --- perimeter hardening (defaults shown) ------------------------------------
# EDD_CSRF_PROTECTION=1
# EDD_RATE_LIMIT_AUTH_PER_MINUTE=10
# EDD_RATE_LIMIT_UPLOAD_PER_MINUTE=6
# EDD_SECURITY_HEADERS=1
# EDD_COOKIE_SECURE=            # blank = Secure automatically when EDD_ENVIRONMENT != local
# --- operations ---------------------------------------------------------------
# EDD_SNAPSHOT_DIR=storage/snapshot
# EDD_BACKUP_DIR=storage/backups
# EDD_BACKUP_KEEP=14
# EDD_BACKUP_HOUR_UTC=1
# EDD_STATIC_DIR=               # serve frontend/dist from the API (Docker image sets this)

# --- single sign-on (OpenID Connect, e.g. Microsoft Entra ID) ------------------
# Register an app in Entra: Web platform, redirect URI <EDD_PUBLIC_URL>/api/v1/auth/sso/callback, ID tokens, a client secret.
# EDD_SSO_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# EDD_SSO_CLIENT_ID=
# EDD_SSO_CLIENT_SECRET=
# EDD_SSO_LABEL=Microsoft
# EDD_SSO_DOMAIN_HINT=endava.com
# EDD_SSO_DEFAULT_ROLE=employee        # role for first-time SSO users; superuser can change it in User Management
# EDD_SSO_AUTO_ACTIVATE=1              # 0 = new SSO users wait for superuser approval
# EDD_SSO_ALLOW_LOCAL_LOGIN=1          # 0 = hide the e-mail/password form (guests & demo accounts still work via the API)

# --- intelligence (optional language model) -----------------------------------
# Risk scoring, anomalies, recommendations and the assistant all work WITHOUT a language model (rule-based parsing).
# Configure one only to improve question understanding and to polish narratives. Only aggregate figures are sent
# unless EDD_LLM_SEND_DETAILS=1.
# EDD_LLM_PROVIDER=                    # "" (off) | azure_openai | openai_compatible
# EDD_LLM_ENDPOINT=                    # Azure: https://<resource>.openai.azure.com ; compatible: https://host/v1
# EDD_LLM_API_KEY=
# EDD_LLM_MODEL=                       # Azure deployment name or model id
# EDD_LLM_API_VERSION=2024-10-21
# EDD_LLM_TIMEOUT_SECONDS=30
# EDD_LLM_SEND_DETAILS=0               # 1 = allow ticket summaries to be sent to the model

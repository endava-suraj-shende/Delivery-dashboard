# Copy to .env (project root) and adjust. All variables are optional.
# Prefix: EDD_

# Folder with the per-employee bi-weekly workbooks (read-only source of truth)
EDD_DATA_DIR=./Data

# Runtime storage for uploads and generated reports (must NOT be inside EDD_DATA_DIR)
EDD_UPLOAD_DIR=./storage/uploads
EDD_REPORT_DIR=./storage/reports

# Server
EDD_HOST=127.0.0.1
EDD_PORT=8000
EDD_LOG_LEVEL=INFO
EDD_ENVIRONMENT=local
EDD_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Behaviour
EDD_DEFAULT_PERIOD_DAYS=30
EDD_MAX_UPLOAD_MB=25
EDD_REPORT_RETENTION=50

# Jira Cloud (optional). Boards are added by link in the UI (Jira Connections) and stored in
# backend/config/jira_boards.json. Only credentials live here.
EDD_JIRA_EMAIL=you@company.com
EDD_JIRA_API_TOKEN=
EDD_JIRA_AUTO_SYNC=true
EDD_JIRA_CACHE_MINUTES=10
EDD_JIRA_TIMEOUT_SECONDS=30
# Per-board alternative credentials for other Atlassian sites (name the env vars in the board settings)
# EDD_JIRA_EMAIL_FLYWHEEL=
# EDD_JIRA_TOKEN_FLYWHEEL=

# Primary data source: auto | jira | excel | both (can also be changed in Settings)
EDD_DATA_SOURCE=auto
EDD_JIRA_LOOKBACK_DAYS=180
EDD_JIRA_REFRESH_MINUTES=15
EDD_JIRA_MAX_ISSUES_PER_BOARD=3000

# Database (SQLite by default). Create / upgrade the schema with:  python manage.py migrate
EDD_DATABASE_URL=sqlite:///./storage/app.db
EDD_AUTO_MIGRATE=true

# Authentication
EDD_PUBLIC_URL=http://localhost:5173
EDD_SESSION_HOURS=8
EDD_AUTH_SECRET=              # optional; derived from the secret key file when blank
EDD_COOKIE_SECURE=false       # true behind HTTPS
EDD_DEFAULT_ALLOWED_DOMAINS=["endava.com"]

# E-mail (Resend, https://resend.com). Without a key, links are logged (and shown in local env).
EDD_RESEND_API_KEY=
EDD_EMAIL_FROM=Delivery Dashboard <onboarding@resend.dev>
